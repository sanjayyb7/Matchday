# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=

# InsForge backend (set NEXT_PUBLIC_USE_INSFORGE=true to enable)
NEXT_PUBLIC_INSFORGE_URL=https://f3efi8df.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=
NEXT_PUBLIC_USE_INSFORGE=false
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Server-only (never commit real values)
INSFORGE_API_KEY=

# Resend — required for Google sign-in alert emails (free tier works).
# Create a key at https://resend.com — InsForge free plan cannot send custom email.
RESEND_API_KEY=
# Optional verified sender (defaults to Resend onboarding address while testing)
# RESEND_FROM_EMAIL=LocalDerby <onboarding@resend.dev>

# Stripe — LocalDerby for Pubs ($10/mo)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=

# Pioneer — structure Terac field notes
PIONEER_API_KEY=

# Terac
TERAC_API_KEY=

# API-Football — live fixtures (https://www.api-football.com/)
# Also used to enrich real player headshots when football-data provides names.
# Configure API_FOOTBALL_KEY_2 (and _3, _4, …) to automatically fail over to
# another key when the first hits its daily quota.
API_FOOTBALL_KEY=
API_FOOTBALL_KEY_2=
# Optional: free tier supports 2022–2024 seasons only (default season is 2026)
# API_FOOTBALL_WC_LEAGUE_ID=1
# API_FOOTBALL_WC_SEASON=2022

# football-data.org — failover (PL / La Liga / Bundesliga / MLS)
# Auth header: X-Auth-Token. Watch X-RequestsAvailable + X-RequestCounter-Reset.
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# SportMonks — failover when API-Football fails/credits run out
# https://my.sportmonks.com/api/tokens
SPORTMONKS_API_KEY=

# Temporary test slate: Premier League / La Liga / Bundesliga / MLS through this weekend
# MATCH_TEST_WEEKEND=1
